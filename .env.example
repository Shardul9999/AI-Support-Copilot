# Phase 1 — generation (Groq, free tier: https://console.groq.com)
GROQ_API_KEY=

# Phase 2 onward — embeddings (Gemini, free tier: https://aistudio.google.com) and database (Supabase Postgres)
# Not needed until Phase 2 — left here so the full set of secrets this project needs is visible in one place.
GEMINI_API_KEY=
DATABASE_URL=

# Phase 5 onward — queue (Celery broker/backend). Upstash Redis free tier: https://upstash.com
REDIS_URL=

# Phase 7 — restricted role the running app connects as (DATABASE_URL above becomes
# admin-only: schema/migration/ingestion scripts). Generated by running, once:
#   python -m scripts.setup_app_role
# which writes this value into .env directly — don't set it by hand.
APP_DATABASE_URL=
